# Backend
NODE_ENV=development
PORT=3001

# Database
# DB_TYPE: postgres (production) | sqlite (local dev fallback when no docker)
DB_TYPE=postgres
DATABASE_URL=postgresql://tic_user:tic_pass@localhost:5432/tic_analysis
# SQLite fallback (only used when DB_TYPE=sqlite)
SQLITE_PATH=./data/dev.sqlite

# Redis (optional; leave empty to disable cache)
REDIS_URL=redis://localhost:6379/2

# Sentry (optional, leave empty to disable)
SENTRY_DSN=

# CORS (comma separated, * for all)
CORS_ORIGINS=http://localhost:5174,http://150.158.21.209:5174

# Cache TTL (seconds)
CACHE_TTL=300

# Rate Limit (req/min per IP)
RATE_LIMIT=60
